    rusBtn.Font = Enum.Font.GothamBold
    rusBtn.TextSize = 16
    rusBtn.Parent = choiceFrame
    
    -- AIM FUNCTION
    local function aimAtHead(targetPlayer)
        if not targetPlayer or not targetPlayer.Character then return false end
        local head = targetPlayer.Character:FindFirstChild("Head")
        if not head then return false end
        camera.CFrame = CFrame.new(camera.CFrame.Position, head.Position)
        return true
    end
    
    -- CREATE MAIN AIMBOT GUI
    local function createAimbotGUI(lang)
        languageGui:Destroy()
        
        local screenGui = Instance.new("ScreenGui")
        screenGui.Name = "AimbotUI"
        screenGui.ResetOnSpawn = false
        screenGui.Parent = localPlayer:WaitForChild("PlayerGui")
        
        local mainFrame = Instance.new("Frame")
        mainFrame.Size = UDim2.new(0, 290, 0, 190)
        mainFrame.Position = UDim2.new(0.5, -145, 0.7, 0)
        mainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
        mainFrame.BorderSizePixel = 1
        mainFrame.BorderColor3 = Color3.fromRGB(100, 100, 120)
        mainFrame.Active = true
        mainFrame.Draggable = true
        mainFrame.Parent = screenGui
        
        local title = Instance.new("TextLabel")
        title.Size = UDim2.new(1, 0, 0, 28)
        title.BackgroundColor3 = Color3.fromRGB(10, 10, 18)
        title.Font = Enum.Font.GothamBold
        title.TextSize = 14
        if lang == "EN" then
            title.Text = "TARGET SELECTION & AIMBOT"
        else
            title.Text = "ВЫБОР ЦЕЛИ И AIMBOT"
        end
        title.TextColor3 = Color3.fromRGB(220, 220, 220)
        title.Parent = mainFrame
        
        local playerListBox = Instance.new("ScrollingFrame")
        playerListBox.Size = UDim2.new(0.9, 0, 0.48, 0)
        playerListBox.Position = UDim2.new(0.05, 0, 0.18, 0)
        playerListBox.BackgroundColor3 = Color3.fromRGB(30, 30, 42)
        playerListBox.BorderSizePixel = 1
        playerListBox.ScrollBarThickness = 8
        playerListBox.Parent = mainFrame
        
        local playerListLayout = Instance.new("UIListLayout")
        playerListLayout.Padding = UDim.new(0, 2)
        playerListLayout.Parent = playerListBox
        
        local selectedPlayerLabel = Instance.new("TextLabel")
        selectedPlayerLabel.Size = UDim2.new(0.9, 0, 0, 22)
        selectedPlayerLabel.Position = UDim2.new(0.05, 0, 0.71, 0)
        selectedPlayerLabel.BackgroundColor3 = Color3.fromRGB(40, 40, 52)
        selectedPlayerLabel.Font = Enum.Font.Gotham
        selectedPlayerLabel.TextSize = 12
        if lang == "EN" then
            selectedPlayerLabel.Text = "TARGET: NONE"
        else
            selectedPlayerLabel.Text = "ЦЕЛЬ: НЕТ"
        end
        selectedPlayerLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
        selectedPlayerLabel.Parent = mainFrame
        
        local statusLabel = Instance.new("TextLabel")
        statusLabel.Size = UDim2.new(0.45, 0, 0, 22)
        statusLabel.Position = UDim2.new(0.05, 0, 0.84, 0)
        statusLabel.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        statusLabel.Font = Enum.Font.GothamBold
        statusLabel.TextSize = 12
        if lang == "EN" then
            statusLabel.Text = "STATUS: OFF"
        else
            statusLabel.Text = "СТАТУС: ВЫКЛ"
        end
        statusLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
        statusLabel.Parent = mainFrame
        
        local toggleBtn = Instance.new("TextButton")
        toggleBtn.Size = UDim2.new(0.35, 0, 0, 24)
        toggleBtn.Position = UDim2.new(0.6, 0, 0.83, 0)
        toggleBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 90)
        toggleBtn.Font = Enum.Font.Gotham
        toggleBtn.TextSize = 12
        if lang == "EN" then
            toggleBtn.Text = "ON / OFF"
        else
            toggleBtn.Text = "ВКЛ / ВЫКЛ"
        end
        toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        toggleBtn.Parent = mainFrame
        
        local selectedPlayer = nil
        local aimbotEnabled = false
        
        local function updatePlayerList()
            for _, child in ipairs(playerListBox:GetChildren()) do
                if child:IsA("TextButton") then child:Destroy() end
            end
            
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= localPlayer then
                    local btn = Instance.new("TextButton")
                    btn.Size = UDim2.new(1, 0, 0, 26)
                    btn.BackgroundColor3 = Color3.fromRGB(50, 50, 68)
                    btn.Text = player.Name
                    btn.TextColor3 = Color3.fromRGB(220, 220, 220)
                    btn.Font = Enum.Font.Gotham
                    btn.TextSize = 12
                    btn.Parent = playerListBox
                    
                    btn.MouseButton1Click:Connect(function()
                        selectedPlayer = player
                        if lang == "EN" then
                            selectedPlayerLabel.Text = "TARGET: " .. player.Name
                        else
                            selectedPlayerLabel.Text = "ЦЕЛЬ: " .. player.Name
                        end
                    end)
                end
            end
        end
        
        local function startAimbotLoop()
            while aimbotEnabled do
                if aimbotEnabled and selectedPlayer and selectedPlayer.Character then
                    local head = selectedPlayer.Character:FindFirstChild("Head")
                    if head then
                        aimAtHead(selectedPlayer)
                    end
                end
                task.wait(0.016)
            end
        end
        
        local function toggleAimbot()
            aimbotEnabled = not aimbotEnabled
            
            if aimbotEnabled then
                if not selectedPlayer then
                    if lang == "EN" then
                        statusLabel.Text = "STATUS: NO TARGET"
                        statusLabel.TextColor3 = Color3.fromRGB(255, 165, 0)
                    else
                        statusLabel.Text = "СТАТУС: НЕТ ЦЕЛИ"
                        statusLabel.TextColor3 = Color3.fromRGB(255, 165, 0)
                    end
                    aimbotEnabled = false
                    return
                end
                if lang == "EN" then
                    statusLabel.Text = "STATUS: ON"
                    statusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
                else
                    statusLabel.Text = "СТАТУС: ВКЛ"
                    statusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
                end
                mainFrame.BorderColor3 = Color3.fromRGB(0, 255, 0)
                task.spawn(startAimbotLoop)
            else
                if lang == "EN" then
                    statusLabel.Text = "STATUS: OFF"
                    statusLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
                else
                    statusLabel.Text = "СТАТУС: ВЫКЛ"
                    statusLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
                end
                mainFrame.BorderColor3 = Color3.fromRGB(100, 100, 120)
            end
        end
        
        toggleBtn.MouseButton1Click:Connect(toggleAimbot)
        
        Players.PlayerAdded:Connect(function() updatePlayerList() end)
        Players.PlayerRemoving:Connect(function()
            if selectedPlayer and not Players:FindFirstChild(selectedPlayer.Name) then
                selectedPlayer = nil
                if lang == "EN" then
                    selectedPlayerLabel.Text = "TARGET: NONE"
                    if aimbotEnabled then
                        aimbotEnabled = false
                        statusLabel.Text = "STATUS: OFF (TARGET LOST)"
                        statusLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
                        mainFrame.BorderColor3 = Color3.fromRGB(100, 100, 120)
                    end
                else
                    selectedPlayerLabel.Text = "ЦЕЛЬ: НЕТ"
                    if aimbotEnabled then
                        aimbotEnabled = false
                        statusLabel.Text = "СТАТУС: ВЫКЛ (ЦЕЛЬ ПОТЕРЯНА)"
                        statusLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
                        mainFrame.BorderColor3 = Color3.fromRGB(100, 100, 120)
                    end
                end
            end
            updatePlayerList()
        end)
        
        updatePlayerList()
    end
    
    engBtn.MouseButton1Click:Connect(function() createAimbotGUI("EN") end)
    rusBtn.MouseButton1Click:Connect(function() createAimbotGUI("RU") end)
end

