-- SUSPICIOUS PATTERNS
local suspiciousNames = {
    "Remote", "RemoteEvent", "RemoteFunction", "BindableEvent", "BindableFunction",
    "Script", "LocalScript", "ModuleScript", "RbxAnalyticsService", "TeleportService",
    "HttpService", "HttpRbxApiService", "MarketplaceService", "DataStoreService",
    "RunService", "ReplicatedFirst", "ReplicatedStorage", "ServerStorage"
}

local suspiciousSources = {
    "loadstring", "getfenv", "setfenv", "getrenv", "setrenv", "syn", "protosmasher",
    "Krnl", "Execute", "send request", "HttpService:GetAsync", "HttpService:PostAsync",
    "game:HttpGet", "game:GetObjects", "PluginManager", "CreatePlugin", "Plugin",
    "debug.setlocal", "debug.getlocal", "getrawmetatable", "setrawmetatable",
    "hookfunction", "hookmetamethod", "newcclosure", "checkcaller", "getcallingscript",
    "identifyexecutor", "getexecutorname", "queue_on_teleport", "rconsoleprint",
    "writefile", "readfile", "listfiles", "makefolder", "delfile", "appendfile"
}

-- SCAN SINGLE INSTANCE
local function scanInstance(instance, depth)
    if depth > 8 then return {} end
    local threats = {}
    
    for _, name in pairs(suspiciousNames) do
        if instance.Name:find(name) then
            table.insert(threats, "Suspicious name: " .. instance.Name)
            break
        end
    end
    
    if instance:IsA("RemoteEvent") or instance:IsA("RemoteFunction") then
        table.insert(threats, "Remote object: " .. instance.ClassName .. " - " .. instance.Name)
    end
    
    if instance:IsA("Script") or instance:IsA("LocalScript") then
        local source = instance.Source
        if source then
            for _, pattern in pairs(suspiciousSources) do
                if source:find(pattern) then
                    table.insert(threats, "Suspicious code in " .. instance.ClassName .. ": " .. pattern)
                    break
                end
            end
        end
    end
    
    if instance:IsA("ModuleScript") and instance.Name == "MainModule" then
        table.insert(threats, "Suspicious ModuleScript: " .. instance.Name)
    end
    
    return threats
end

-- MAIN SCAN
local function startScan()
    for _, child in ipairs(logBox:GetChildren()) do
        if child:IsA("TextLabel") then child:Destroy() end
    end
    
    addLog("=== SCAN STARTED ===", Color3.fromRGB(255, 255, 0))
    statusLabel.Text = "SCANNING..."
    statusLabel.TextColor3 = Color3.fromRGB(255, 165, 0)
    
    local threatsFound = 0
    local totalScanned = 0
    
    local function traverse(inst, depth)
        if depth > 10 then return end
        totalScanned = totalScanned + 1
        
        local threats = scanInstance(inst, depth)
        for _, threat in pairs(threats) do
            threatsFound = threatsFound + 1
            addLog("[!] " .. threat .. " | Path: " .. inst:GetFullName(), Color3.fromRGB(255, 100, 100))
        end
        
        for _, child in pairs(inst:GetChildren()) do
            traverse(child, depth + 1)
        end
    end
    
    local services = {
        game, Workspace, ReplicatedStorage, ServerScriptService, Lighting,
        game:GetService("Players"), game:GetService("TeleportService"),
        game:GetService("HttpService"), game:GetService("RunService")
    }
    
    for _, service in pairs(services) do
        if service then
            addLog("Scanning: " .. service.Name, Color3.fromRGB(150, 150, 255))
            traverse(service, 0)
        end
    end
    
    addLog("=== RESULTS ===", Color3.fromRGB(255, 255, 0))
    addLog("Total objects scanned: " .. totalScanned, Color3.fromRGB(200, 200, 200))
    if threatsFound == 0 then
        addLog("NO THREATS DETECTED", Color3.fromRGB(0, 255, 0))
        statusLabel.Text = "SCAN COMPLETE: CLEAN"
        statusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
    else
        addLog("THREATS FOUND: " .. threatsFound, Color3.fromRGB(255, 0, 0))
        statusLabel.Text = "SCAN COMPLETE: " .. threatsFound .. " THREATS"
        statusLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
    end
end

local function clearLog()
    for _, child in ipairs(logBox:GetChildren()) do
        if child:IsA("TextLabel") then child:Destroy() end
    end
    addLog("LOG CLEARED", Color3.fromRGB(200, 200, 200))
    statusLabel.Text = "READY"
    statusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
end

